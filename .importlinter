[importlinter]
root_package = aibridge_exec
include_external_packages = True

[importlinter:contract:stateless]
name = Execution layer stays stateless and host-agnostic
type = forbidden
source_modules =
    aibridge_exec
forbidden_modules =
    flask
    werkzeug
    sqlalchemy
    flask_sqlalchemy
    redis
    kafka
    celery
    aibridge

[importlinter:contract:core_without_web]
name = Library modules do not depend on the HTTP server stack
type = forbidden
source_modules =
    aibridge_exec.providers
    aibridge_exec.contracts
    aibridge_exec.code_runtime
forbidden_modules =
    aibridge_exec.server
    fastapi
    starlette
    uvicorn
    pydantic
